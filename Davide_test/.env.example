# --- Email (email_service.py) ---
RESULT_EMAIL=            # where the receipt goes: the organizers' address on race day
TEAM_NUMBER=             # goes in the subject line
CURRENCY=CAD
EMAIL_PROVIDER=          # smtp | resend; blank = resend if RESEND_API_KEY is set, else smtp
EMAIL_BCC=               # optional: a team inbox that gets a copy of every receipt
EMAIL_FROM=              # optional for smtp; for resend, e.g. "Hotel Agent <agent@yourdomain.com>"

# Gmail SMTP (default). Needs 2FA on, then https://myaccount.google.com/apppasswords
SMTP_USER=               # the Gmail address
SMTP_APP_PASSWORD=       # 16-char app password, not the account password

# Resend (alternative). Needs a verified domain to send to anyone except your own login
RESEND_API_KEY=
